local function AddToggle(text, startValue, y, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 30)
    btn.Position = UDim2.new(0, 20, 0, y)
    btn.Text = text .. ": " .. (startValue and "ON" or "OFF")
    btn.BackgroundColor3 = startValue and Color3.fromRGB(45, 140, 45) or Color3.fromRGB(140, 45, 45)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 14
    btn.Parent = Frame
    Instance.new("UICorner").Parent = btn

    local active = startValue
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = text .. ": " .. (active and "ON" or "OFF")
        btn.BackgroundColor3 = active and Color3.fromRGB(45, 140, 45) or Color3.fromRGB(140, 45, 45)
        callback(active)
    end)
end

local function AddSlider(text, min, max, startValue, y, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 200, 0, 20)
    label.Position = UDim2.new(0, 20, 0, y)
    label.Text = text .. ": " .. startValue
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.SourceSans
    label.TextSize = 13
    label.Parent = Frame

    local slider = Instance.new("TextButton")
    slider.Size = UDim2.new(0, 200, 0, 8)
    slider.Position = UDim2.new(0, 20, 0, y + 20)
    slider.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
    slider.Text = ""
    slider.Parent = Frame
    Instance.new("UICorner").Parent = slider

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((startValue - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(50, 130, 200)
    fill.BorderSizePixel = 0
    fill.Parent = slider
    Instance.new("UICorner").Parent = fill

    local sliding = false
    local function update(input)
        local pct = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        label.Text = text .. ": " .. val
        callback(val)
    end

    slider.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
end

