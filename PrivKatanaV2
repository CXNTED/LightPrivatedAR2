-- Target Body Part Filter Logic - FIXED TO ISOLATE MODE
local function getTargetableParts(model)
    local parts = {}
    
    if Settings.TargetMode == "Head" then
        local head = model:FindFirstChild("Head")
        if head then table.insert(parts, head) end
    elseif Settings.TargetMode == "UpperTorso" then
        local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
        if torso then table.insert(parts, torso) end
    else
        -- "Closest Part" Mode
        local head = model:FindFirstChild("Head")
        local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
        if head then table.insert(parts, head) end
        if torso then table.insert(parts, torso) end
    end
    
    return parts
end

-- Raycast Obstruction Filter Validation
local function isPartVisible(targetPart, character)
    if not Settings.WallCheckEnabled then return true end
    local charParts = character:GetChildren()
    local myCharParts = localPlayer.Character and localPlayer.Character:GetChildren() or {}
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local filter = {}
    for _, p in ipairs(charParts) do table.insert(filter, p) end
    for _, p in ipairs(myCharParts) do table.insert(filter, p) end
    if camera then table.insert(filter, camera) end
    
    params.FilterDescendantsInstances = filter
    
    local rayResult = workspace:Raycast(camera.CFrame.Position, targetPart.Position - camera.CFrame.Position, params)
    return rayResult == nil
end

-- Continuous Target Scan and Visual Overlay Management
RunService.RenderStepped:Connect(function()
    local mouseLoc = UserInputService:GetMouseLocation()
    local myCharacter = localPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    
    fov.Position = mouseLoc
    fov.Visible = Settings.FovVisible
    fov.Radius = Settings.FovRadius

    local closestPart = nil
    local closestDist2D = math.huge

    local function scan(model)
        for _, part in ipairs(getTargetableParts(model)) do
            local dist3D = myRoot and (part.Position - myRoot.Position).Magnitude or math.huge
            if dist3D <= Settings.TargetMaxDist then
                local targetFovScale = (dist3D <= Settings.CloseRangeLimit) and Settings.DynamicFovRadius or Settings.FovRadius
                
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and isPartVisible(part, model) then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - mouseLoc).Magnitude
                    if dist2D < targetFovScale and dist2D < closestDist2D then
                        closestDist2D = dist2D
                        closestPart = part
                    end
                end
            end
        end
    end

    if workspace:FindFirstChild("Characters") then
        for _, m in ipairs(workspace.Characters:GetChildren()) do 
            if m ~= myCharacter then scan(m) end 
        end
    end

    currentTargetPart = closestPart

    if Settings.SnaplineEnabled and currentTargetPart and currentTargetPart.Parent then
        local targetPos = currentTargetPart.Position
        local cache = positionCache[currentTargetPart]
        local vel = cache and cache.velocity or currentTargetPart.AssemblyLinearVelocity or Vector3.zero
        
        if vel.Magnitude > 0.1 and myRoot then
            local dist = (targetPos - myRoot.Position).Magnitude
            targetPos = targetPos + (vel * (dist * Settings.DistancePredictionMult))
        end

        local origin = camera.CFrame.Position
        local targetDirection = (targetPos - origin).Unit
        
        local smoothAlpha = 1 / math.max(1, Settings.AimSmoothing)
        visualSmoothDirection = visualSmoothDirection:Lerp(targetDirection, smoothAlpha)
        
        local finalVisualTargetPos = origin + (visualSmoothDirection * (targetPos - origin).Magnitude)
        local screenPos, onScreen = camera:WorldToViewportPoint(finalVisualTargetPos)
        
        if onScreen then
            snapline.From = mouseLoc
            snapline.To = Vector2.new(screenPos.X, screenPos.Y)
            snapline.Visible = true
        else
            snapline.Visible = false
        end
    else
        visualSmoothDirection = camera.CFrame.LookVector
        snapline.Visible = false
    end
end)

-- Velocity Tracker Engine
RunService.Heartbeat:Connect(function(deltaTime)
    local function track(model)
        for _, name in ipairs({"Head", "Torso", "UpperTorso"}) do
            local part = model:FindFirstChild(name)
            if part then
                local data = positionCache[part]
                if data then
                    data.velocity = (part.Position - data.lastPos) / deltaTime
                    data.lastPos = part.Position
                else
                    positionCache[part] = {lastPos = part.Position, velocity = Vector3.zero}
                end
            end
        end
    end
    if workspace:FindFirstChild("Characters") then
        for _, m in ipairs(workspace.Characters:GetChildren()) do if m ~= localPlayer.Character then track(m) end end
    end
end)

-- Main Intercept Hook Logic for Fire
function Bullets.Fire(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
    local originalSpreadValues = {}
    
    -- Check hipfire state cleanly without touching crosshair logic
    local isHipfiring = true
    if type(weaponData) == "table" then
        local aimingState = weaponData.Aiming or weaponData.IsAiming or weaponData.ADS or (playerController and (playerController.Aiming or playerController.IsAiming))
        if aimingState == true then
            isHipfiring = false
        end
    end

    -- Strip spread if hipfiring
    if Settings.NoSpreadEnabled and isHipfiring and type(weaponData) == "table" then
        local targetKeys = {
            "Spread", "BaseSpread", "MaxSpread", "MinSpread", 
            "HipfireSpread", "HipSpread", "SpreadIncrement", 
            "SpreadDecay", "Accuracy", "Inaccuracy"
        }
        for _, key in ipairs(targetKeys) do
            if weaponData[key] ~= nil then
                originalSpreadValues[key] = weaponData[key]
                weaponData[key] = 0
            end
        end
    end

    -- If aimbot is off or no target found, fire normally
    if not Settings.AimbotEnabled or not currentTargetPart or not currentTargetPart.Parent then 
        local result = originalFire(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        for key, value in pairs(originalSpreadValues) do weaponData[key] = value end
        return result
    end

    -- Double Check Part Enforcement Check (Prevents Torso Override if Head is selected)
    local targetCharacter = currentTargetPart.Parent
    local finalTargetPart = currentTargetPart
    if Settings.TargetMode == "Head" then
        local forcedHead = targetCharacter:FindFirstChild("Head")
        if forcedHead then finalTargetPart = forcedHead end
    elseif Settings.TargetMode == "UpperTorso" then
        local forcedTorso = targetCharacter:FindFirstChild("UpperTorso") or targetCharacter:FindFirstChild("Torso")
        if forcedTorso then finalTargetPart = forcedTorso end
    end

    local targetPos = finalTargetPart.Position
    local cache = positionCache[finalTargetPart]
    local vel = cache and cache.velocity or finalTargetPart.AssemblyLinearVelocity or Vector3.zero
    
    if vel.Magnitude > 0.1 then
        local dist = (targetPos - origin).Magnitude
        targetPos = targetPos + (vel * (dist * Settings.DistancePredictionMult))
    end
    
    local calculatedDirection = (targetPos - origin).Unit
    local smoothAlpha = 1 / math.max(1, Settings.AimSmoothing)
    local finalDirection = direction:Lerp(calculatedDirection, smoothAlpha)
    
    local result = originalFire(self, playerController, weaponInstance, weaponData, origin, finalDirection, shotId)

    -- Complete field cleanup
    for key, value in pairs(originalSpreadValues) do
        weaponData[key] = value
    end

    return result
end

